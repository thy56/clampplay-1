<mxfile host="app.diagrams.net" modified="2026-10-01T16:30:00.000Z" agent="OpenClaw" version="24.7.17"><diagram name="ClampPlay-1 统一控制器与可拆卸乐器模块图"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="移动端 App&#xa;选择乐器 / 曲目&#xa;生成音符或节拍指令&#xa;配置力度、速度、时序&#xa;监看状态与急停" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#E8732A;fontColor=#17191E;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="230" height="165" as="geometry"/></mxCell><mxCell id="n3" value="通用控制器主机&#xa;主控 MCU / 协议解析&#xa;可扩展驱动通道&#xa;供电、限流、急停&#xa;传感器采集与状态回读&#xa;模块身份识别 / 快拆接口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBFA;strokeColor=#4B93E6;fontColor=#17191E;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;spacing=10;" vertex="1" parent="1"><mxGeometry x="375" y="175" width="310" height="310" as="geometry"/></mxCell><mxCell id="n4" value="钢琴自动按键组件&#xa;夹持于键盘上方&#xa;键位执行器阵列&#xa;每个音符 → 对应键位按压&#xa;毛毡/硅胶接触 + 回位" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0E7FA;strokeColor=#7856B6;fontColor=#17191E;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;spacing=10;" vertex="1" parent="1"><mxGeometry x="800" y="75" width="300" height="195" as="geometry"/></mxCell><mxCell id="n5" value="吉他自动演奏组件&#xa;按弦架：品位定位 / 下压&#xa;拨弦架：拨片或拨杆&#xa;先按弦 → 再拨弦&#xa;释放 → 切换下一和弦" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0E7FA;strokeColor=#7856B6;fontColor=#17191E;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;spacing=10;" vertex="1" parent="1"><mxGeometry x="800" y="390" width="300" height="220" as="geometry"/></mxCell><mxCell id="n6" value="架子鼓自动敲击组件&#xa;夹具固定鼓圈 / 支架&#xa;电磁铁或推杆鼓槌&#xa;节拍指令 → 对应鼓面敲击&#xa;行程 / 回位 / 限力" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0E7FA;strokeColor=#7856B6;fontColor=#17191E;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;spacing=10;" vertex="1" parent="1"><mxGeometry x="800" y="705" width="300" height="170" as="geometry"/></mxCell><mxCell id="n7" value="乐器与声音输出&#xa;钢琴键位与音阶&#xa;吉他弦与和弦&#xa;军鼓 / 底鼓 / 镲片&#xa;实体乐器发声" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAED;strokeColor=#3C4048;fontColor=#17191E;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;spacing=10;" vertex="1" parent="1"><mxGeometry x="1210" y="320" width="280" height="260" as="geometry"/></mxCell><mxCell id="n8" value="反馈与安全&#xa;FSR / 限位 / 回位&#xa;模块在位检测&#xa;过流 / 超温 / 超时&#xa;急停释放全部组件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEF3E8;strokeColor=#2D9C72;fontColor=#17191E;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;spacing=10;" vertex="1" parent="1"><mxGeometry x="1210" y="710" width="280" height="165" as="geometry"/></mxCell><mxCell id="e1" value="曲目 / 指令" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#667085;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="钢琴模块接口" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#667085;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="吉他模块接口" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#667085;" edge="1" parent="1" source="n3" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="鼓模块接口" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#667085;" edge="1" parent="1" source="n3" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="按键发声" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;s