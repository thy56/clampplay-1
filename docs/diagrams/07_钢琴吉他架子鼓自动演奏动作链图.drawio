<mxfile host="app.diagrams.net" modified="2026-10-01T16:30:00.000Z" agent="OpenClaw" version="24.7.17"><diagram name="ClampPlay-1 钢琴、吉他、架子鼓自动演奏动作链图"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="钢琴音符指令&#xa;例如 C4 / D4 / E4&#xa;时间、力度、持续时间" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#E8732A;fontColor=#17191E;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="115" width="230" height="115" as="geometry"/></mxCell><mxCell id="n3" value="钢琴键位映射&#xa;音符 → 键位编号&#xa;检查模块已安装&#xa;选择对应执行器" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBFA;strokeColor=#4B93E6;fontColor=#17191E;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;spacing=10;" vertex="1" parent="1"><mxGeometry x="365" y="115" width="245" height="115" as="geometry"/></mxCell><mxCell id="n4" value="按键执行单元&#xa;执行器对准单一键位&#xa;电磁铁 / 伺服下压&#xa;软触头按键&#xa;弹簧回位 / 限位" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAED;strokeColor=#3C4048;fontColor=#17191E;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;spacing=10;" vertex="1" parent="1"><mxGeometry x="700" y="70" width="270" height="205" as="geometry"/></mxCell><mxCell id="n5" value="钢琴自动按键结果&#xa;键位被按下&#xa;钢琴本体发出对应音阶&#xa;动作完成后释放" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0E7FA;strokeColor=#7856B6;fontColor=#17191E;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;spacing=10;" vertex="1" parent="1"><mxGeometry x="1060" y="115" width="285" height="115" as="geometry"/></mxCell><mxCell id="n6" value="吉他和弦指令&#xa;例如 Am / G / F&#xa;节拍、速度、扫弦方向" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#E8732A;fontColor=#17191E;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="410" width="230" height="115" as="geometry"/></mxCell><mxCell id="n7" value="和弦展开与时序&#xa;和弦 → 弦 / 品位置&#xa;先按弦确认&#xa;等待稳定窗口&#xa;触发拨弦 / 扫弦" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBFA;strokeColor=#4B93E6;fontColor=#17191E;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;spacing=10;" vertex="1" parent="1"><mxGeometry x="365" y="395" width="245" height="150" as="geometry"/></mxCell><mxCell id="n8" value="自动按弦架&#xa;可调品位执行器&#xa;硅胶压弦指&#xa;导轨定位&#xa;压力反馈 / 回位" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAED;strokeColor=#3C4048;fontColor=#17191E;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;spacing=10;" vertex="1" parent="1"><mxGeometry x="700" y="350" width="270" height="195" as="geometry"/></mxCell><mxCell id="n9" value="自动拨弦架&#xa;横向拨片滑台&#xa;拨杆 / 拨片执行器&#xa;单弦、分解、扫弦&#xa;拨弦速度可调" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAED;strokeColor=#3C4048;fontColor=#17191E;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;spacing=10;" vertex="1" parent="1"><mxGeometry x="700" y="620" width="270" height="175" as="geometry"/></mxCell><mxCell id="n10" value="吉他自动演奏结果&#xa;按弦到位 → 拨弦&#xa;琴弦振动形成和弦&#xa;释放旧指法 → 切换" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0E7FA;strokeColor=#7856B6;fontColor=#17191E;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;spacing=10;" vertex="1" parent="1"><mxGeometry x="1060" y="475" width="285" height="150" as="geometry"/></mxCell><mxCell id="n11" value="架子鼓节拍指令&#xa;Kick / Snare / Hi-hat&#xa;BPM、力度、节奏型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#E8732A;fontColor=#17191E;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="720" width="230" height="115" as="geometry"/></mxCell><mxCell id="n12" value="鼓位映射与调度&#xa;事件 → 鼓位模块&#xa;选择鼓槌通道&#xa;设定击打力度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBFA;strokeColor=#4B93E6;fontColor=#17191E;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;spacing=10;" vertex="1" parent="1"><mxGeometry x="365" y="710" width="245" height="140" as="geometry"/></mxCell><mxCell id="n13" value="自动鼓槌组